{
  "realm": "ticket-realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      { "name": "customer", "description": "Books tickets: the role every self-registered account gets" },
      { "name": "admin", "description": "Back-office administrator: unlocks /admin/**" }
    ]
  },
  "clients": [
    {
      "clientId": "ticket-app",
      "name": "Ticket Management System (public client)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"]
    },
    {
      "clientId": "ticket-backend",
      "name": "Ticket Management System (service account)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "ticket-backend-secret",
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "service-account-ticket-backend",
      "enabled": true,
      "serviceAccountClientId": "ticket-backend",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "view-realm"]
      }
    },
    {
      "username": "admin@gmail.com",
      "enabled": true,
      "firstName": "System",
      "lastName": "Admin",
      "email": "admin@gmail.com",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "realmRoles": ["admin", "customer"]
    },
    {
      "username": "customer@gmail.com",
      "enabled": true,
      "firstName": "Demo",
      "lastName": "Customer",
      "email": "customer@gmail.com",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "customer123", "temporary": false }
      ],
      "realmRoles": ["customer"]
    }
  ]
}
