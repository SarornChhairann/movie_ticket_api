# Public entry point: TLS (Let's Encrypt, renewed automatically), HTTP→HTTPS,
# HTTP/2 + HTTP/3, compression, and security headers. The domains come from .env.prod.
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	log {
		output stdout
		format json
	}
}

# The API (REST, /ws STOMP websocket, /uploads images, Swagger).
{$API_DOMAIN} {
	import common

	# Container probes stay internal.
	@internal path /actuator /actuator/*
	respond @internal 404

	request_body {
		max_size 6MB
	}
	reverse_proxy app:8010 {
		health_uri /actuator/health/readiness
		health_interval 15s
	}
}

# Keycloak: login and token endpoints are public; the admin console and the admin
# REST API only from KEYCLOAK_ADMIN_ALLOW. The app calls the admin API inside the
# Docker network, not through here.
{$AUTH_DOMAIN} {
	import common

	@admin {
		path /admin /admin/*
		not remote_ip {$KEYCLOAK_ADMIN_ALLOW}
	}
	respond @admin 403

	@internal path /metrics /metrics/* /health /health/*
	respond @internal 404

	reverse_proxy keycloak:8080
}
