# Public entry on the server IP. No DNS name and no TLS certificate.
# Port 80 is the API. Port 8080 is Keycloak. auto_https is off so Caddy
# does not ask Let's Encrypt for a certificate.
{
	auto_https off
}

(common) {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	log {
		output stdout
		format json
	}
}

:80 {
	import common

	@internal path /actuator /actuator/*
	respond @internal 404

	request_body {
		max_size 6MB
	}
	reverse_proxy app:8010 {
		health_uri /actuator/health/readiness
		health_interval 15s
	}
}

:8080 {
	import common

	@admin {
		path /admin /admin/*
		not remote_ip {$KEYCLOAK_ADMIN_ALLOW}
	}
	respond @admin 403

	@internal path /metrics /metrics/* /health /health/*
	respond @internal 404

	reverse_proxy keycloak:8080
}
