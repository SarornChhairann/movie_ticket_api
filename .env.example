# =============================================================================
# Template for .env - copy it and edit:   cp .env.example .env
#
# .env holds every setting this project has, and is read by both:
#   - docker compose  (substitutes ${VAR} in docker-compose.yml)
#   - the app itself  (application.yml imports it, see spring.config.import)
#
# Precedence: a real environment variable always beats a line in the file, so
# docker-compose.yml can still point the container at db:5432 / redis:6379
# while these values describe running the app on your own machine.
#
# The values below are the demo defaults - the app boots with exactly these even
# if no .env exists, so nothing here is a secret worth guarding. Change the
# passwords before running this anywhere real.
# =============================================================================


# --- Ports -------------------------------------------------------------------
# Production Compose (Caddy). The public IPv4 of the server. Not a DNS name.
PUBLIC_IP=
SERVER_PORT=8010
# Keep stack traces, exception names, and raw exception messages out of API
# error responses (DevTools would otherwise switch them on for local runs).
SERVER_ERROR_INCLUDE_STACKTRACE=never
SERVER_ERROR_INCLUDE_EXCEPTION=false
SERVER_ERROR_INCLUDE_MESSAGE=never
APP_PORT=8010
POSTGRES_PORT=5433
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379


# --- Database ----------------------------------------------------------------
# POSTGRES_* drive both the db container and the app's JDBC URL, which
# application.yml assembles as jdbc:postgresql://HOST:PORT/DB.
POSTGRES_HOST=localhost
POSTGRES_DB=spring_boot_ticket
POSTGRES_USER=myuser
POSTGRES_PASSWORD=MySecretPassword

# update | create | create-drop | validate | none
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true


# --- Auth: tokens are issued and verified by the app itself -------------------
# HMAC key for the access tokens, at least 32 bytes. Fine for local use only;
# production needs its own:   openssl rand -base64 48
APP_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=7d


# --- The admin account, created/realigned in users on every start -----------
APP_ADMIN_NAME=System Admin
APP_ADMIN_EMAIL=admin@gmail.com
APP_ADMIN_PASSWORD=admin123


# --- Demo data seeding --------------------------------------------------------
APP_SEED_ENABLED=true
# true wipes and reseeds on every start - handy for a demo, destructive otherwise.
APP_SEED_FORCE=true
APP_SEED_HALLS=3
APP_SEED_DAYS=14
APP_SEED_SHOWTIMES_PER_HALL_PER_DAY=3
APP_SEED_CUSTOMERS=25
# Fixed seed = the same demo data every run.
APP_SEED_RANDOM_SEED=20260503

APP_SEED_COUNTS_USERS=24
APP_SEED_COUNTS_CINEMAS=6
APP_SEED_COUNTS_HALLS_PER_CINEMA=3
APP_SEED_COUNTS_MOVIES=15
APP_SEED_COUNTS_SHOWTIMES_PER_MOVIE=5
APP_SEED_COUNTS_FOOD_ITEMS=10
APP_SEED_COUNTS_PROMO_CODES=5
APP_SEED_COUNTS_BOOKINGS=20


# --- File uploads -------------------------------------------------------------
APP_UPLOADS_MOVIES_DIR=uploads/movies
APP_UPLOADS_FOOD_ITEMS_DIR=uploads/food-items
# 5 MB, in bytes. Keep at or below the multipart limits below.
APP_UPLOADS_FOOD_ITEMS_MAX_BYTES=5242880
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=5MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=5MB


# --- CORS ---------------------------------------------------------------------
# Origins allowed to call this API from a browser. Comma-separated.
# Native mobile builds are not subject to CORS. Add the Flutter web dev origin
# only when running `flutter run -d chrome --web-port 5555`.
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5555


# --- Mail ---------------------------------------------------------------------
# Leave username/password blank and email is a no-op locally.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=


# --- RabbitMQ (booking mail queue) -------------------------------------------
# Management UI: http://localhost:15672 (RABBITMQ_USER / RABBITMQ_PASSWORD).
# APP_MAIL_QUEUE_ENABLED=false sends mail in-process instead (no broker needed).
APP_MAIL_QUEUE_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_USER=ticket
RABBITMQ_PASSWORD=ticket
# Send attempts per mail before it is parked in booking.mail.dlq.
RABBITMQ_MAIL_MAX_ATTEMPTS=4


# --- Redis (browse cache, booking-lookup throttle) ---------------------------
# APP_REDIS_ENABLED=false keeps both in memory instead (no Redis needed).
APP_REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PASSWORD=


# --- ABA PayWay (KHQR checkout) ----------------------------------------------
# Leave merchant id / API key blank and the PayWay endpoints answer 503
# PAYWAY_UNAVAILABLE. Put the real sandbox values only in your own .env.
# PAYWAY_API_KEY is the HMAC "public key" from the sandbox mail, not the RSA pair.
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Public URL of POST /api/payway/callback (whitelist its domain on the merchant profile).
PAYWAY_RETURN_URL=
