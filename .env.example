# =============================================================================
# Template for .env - copy it and edit:   cp .env.example .env
#
# .env holds every setting this project has, and is read by both:
#   - docker compose  (substitutes ${VAR} in docker-compose.yml)
#   - the app itself  (application.yml imports it, see spring.config.import)
#
# Precedence: a real environment variable always beats a line in the file, so
# docker-compose.yml can still point the container at db:5432 / keycloak:8080
# while these values describe running the app on your own machine.
#
# The values below are the demo defaults - the app boots with exactly these even
# if no .env exists, so nothing here is a secret worth guarding. Change the
# passwords before running this anywhere real.
# =============================================================================


# --- Ports -------------------------------------------------------------------
SERVER_PORT=8010
APP_PORT=8010
POSTGRES_PORT=5433
KEYCLOAK_PORT=8080


# --- Database ----------------------------------------------------------------
# POSTGRES_* drive both the db container and the app's JDBC URL, which
# application.yml assembles as jdbc:postgresql://HOST:PORT/DB.
POSTGRES_HOST=localhost
POSTGRES_DB=spring_boot_ticket
POSTGRES_USER=myuser
POSTGRES_PASSWORD=MySecretPassword

# update | create | create-drop | validate | none
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true


# --- Keycloak: what the app talks to -----------------------------------------
# Where the app CALLS Keycloak for login, registration and user admin.
KEYCLOAK_SERVER_URL=http://localhost:8080
# Must equal the "iss" claim inside every token; Spring discovers the realm's
# public keys from it. In Docker these two differ - see docker-compose.yml.
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/ticket-realm
KEYCLOAK_REALM=ticket-realm
# Public client used for the password grant behind POST /login.
KEYCLOAK_LOGIN_CLIENT_ID=ticket-app
# Confidential client whose service account holds realm-management: manage-users.
KEYCLOAK_ADMIN_CLIENT_ID=ticket-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=ticket-backend-secret
# Push APP_ADMIN_* into the realm at startup; false leaves the realm alone.
KEYCLOAK_BOOTSTRAP_ADMIN=true


# --- Keycloak: the container itself -------------------------------------------
# Console login at http://localhost:8080/admin
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Hostname Keycloak stamps into the "iss" claim of every token it issues.
KEYCLOAK_PUBLIC_URL=http://localhost:8080


# --- The admin account, kept in step in Keycloak and in users -----------------
APP_ADMIN_NAME=System Admin
APP_ADMIN_EMAIL=admin@gmail.com
APP_ADMIN_PASSWORD=admin123


# --- Demo data seeding --------------------------------------------------------
APP_SEED_ENABLED=true
# true wipes and reseeds on every start - handy for a demo, destructive otherwise.
APP_SEED_FORCE=true
APP_SEED_HALLS=3
APP_SEED_DAYS=14
APP_SEED_SHOWTIMES_PER_HALL_PER_DAY=3
APP_SEED_CUSTOMERS=25
# Fixed seed = the same demo data every run.
APP_SEED_RANDOM_SEED=20260503

APP_SEED_COUNTS_USERS=50
APP_SEED_COUNTS_CINEMAS=3
APP_SEED_COUNTS_HALLS_PER_CINEMA=3
APP_SEED_COUNTS_MOVIES=15
APP_SEED_COUNTS_SHOWTIMES_PER_MOVIE=5
APP_SEED_COUNTS_FOOD_ITEMS=10
APP_SEED_COUNTS_PROMO_CODES=5
APP_SEED_COUNTS_BOOKINGS=20


# --- File uploads -------------------------------------------------------------
APP_UPLOADS_MOVIES_DIR=uploads/movies
APP_UPLOADS_FOOD_ITEMS_DIR=uploads/food-items
# 5 MB, in bytes. Keep at or below the multipart limits below.
APP_UPLOADS_FOOD_ITEMS_MAX_BYTES=5242880
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=5MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=5MB


# --- CORS ---------------------------------------------------------------------
# Origins allowed to call this API from a browser. Comma-separated.
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081


# --- Mail ---------------------------------------------------------------------
# Leave username/password blank and email is a no-op locally.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
