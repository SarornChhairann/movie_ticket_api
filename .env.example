APP_PORT=8010
POSTGRES_PORT=5433
KEYCLOAK_PORT=8080

POSTGRES_DB=spring_boot_ticket
POSTGRES_USER=myuser
POSTGRES_PASSWORD=MySecretPassword

# --- Keycloak ---------------------------------------------------------------
# Console login for Keycloak itself (http://localhost:8080/admin)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Base URL Keycloak stamps into the "iss" claim of every token it issues.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/ticket-realm
KEYCLOAK_REALM=ticket-realm
# Public client the app uses for the password grant behind POST /login.
KEYCLOAK_LOGIN_CLIENT_ID=ticket-app
# Confidential client whose service account creates and maintains users.
KEYCLOAK_ADMIN_CLIENT_ID=ticket-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=ticket-backend-secret
# Push APP_ADMIN_* into the realm at startup; set false to leave the realm alone.
KEYCLOAK_BOOTSTRAP_ADMIN=true

# The admin account, kept in step in both Keycloak and the users table.
APP_ADMIN_EMAIL=admin@gmail.com
APP_ADMIN_PASSWORD=admin123
APP_ADMIN_NAME=System Admin

APP_SEED_ENABLED=true
APP_SEED_FORCE=false

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
