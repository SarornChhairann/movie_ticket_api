# =============================================================================
# Production settings for docker-compose.prod.yml. Copy, fill in, lock down:
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# .env.prod is git-ignored and never baked into the image (.dockerignore).
# Every value marked REQUIRED makes `docker compose` stop with an error if empty.
# Generate secrets with:   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# =============================================================================

# --- Public IP (no DNS). API is http://PUBLIC_IP
PUBLIC_IP=               # REQUIRED
# Browser origins allowed to call the API. REQUIRED.
APP_CORS_ALLOWED_ORIGINS=

# --- Image (leave as is to build on the server; set to pull from a registry) ---
APP_IMAGE=ticket-management-system
APP_TAG=latest
# Extra JVM flags. With the 384M app limit the default 75% heap leaves too little
# for metaspace/threads, so cap heap at 60% (~230M) and metaspace at 128M.
JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:MaxMetaspaceSize=128m

# --- Postgres (app database) ---------------------------------------------------
POSTGRES_DB=ticket
POSTGRES_USER=ticket
POSTGRES_PASSWORD=                         # REQUIRED
# update creates/extends tables on start; use validate once a migration tool owns the schema.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- Auth (tokens are issued by the app itself) ---------------------------------
# REQUIRED. Signs every access token; anyone who has it can log in as anyone.
# At least 32 bytes:   openssl rand -base64 48
# Changing it signs everybody out.
APP_JWT_SECRET=                            # REQUIRED
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=7d

# --- The API's admin account (created/realigned on every start) ---------------
APP_ADMIN_NAME=System Admin
APP_ADMIN_EMAIL=                           # REQUIRED
APP_ADMIN_PASSWORD=                        # REQUIRED

# --- Redis (browse cache, lookup throttle) -------------------------------------
REDIS_PASSWORD=                            # REQUIRED

# --- Mail (blank username = no mail is sent) -----------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- Uploads ----------------------------------------------------------------------
APP_UPLOADS_FOOD_ITEMS_MAX_BYTES=5242880
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=5MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=5MB

# --- ABA PayWay (production host; blank id/key = PayWay answers 503) ------------
PAYWAY_BASE_URL=https://checkout.payway.com.kh
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# http://<PUBLIC_IP>/api/payway/callback . PayWay production usually wants HTTPS on a domain.
PAYWAY_RETURN_URL=
